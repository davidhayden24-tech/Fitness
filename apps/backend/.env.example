DATABASE_URL="postgresql://user:password@localhost:5432/adaptfit"
ANTHROPIC_API_KEY=""
# Both Clerk keys are required for the server to boot at all - clerkMiddleware
# throws on every request (even public ones) if CLERK_PUBLISHABLE_KEY is
# missing or malformed, not just when a session needs verifying.
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Raw JSON (not a file path) of a Google Cloud service account with Play
# Console API access - see src/billing/googlePlay.ts for the exact
# permissions it needs. Only required for /api/billing/verify to work.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
PORT=4000
